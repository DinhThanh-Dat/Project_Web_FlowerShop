@{
    ViewBag.Title = "Liên hệ";
    Layout = "~/Views/Shared/_LayoutBanHoa.cshtml";
}

<div class="container-fluid mt-4">
    <h2 class="section-title text-center mb-4">Liên hệ với chúng tôi</h2>
    <p class="section-subtitle text-center" style="margin-top: -1.5rem; margin-bottom: 3rem;">
        Chúng tôi luôn sẵn sàng lắng nghe bạn.
    </p>

    <div class="row g-4 g-lg-5">
        <div class="col-lg-6">
            <h4 class="fw-bold">Thông tin liên hệ</h4>
            <ul class="contact-info-list">
                <li class="contact-info-item">
                    <i class="fas fa-map-marker-alt"></i>
                    <div>
                        <strong>Địa chỉ</strong>
                        <span>123 Đường Hoa, Quận 1, TP. Hồ Chí Minh</span>
                    </div>
                </li>
                <li class="contact-info-item">
                    <i class="fas fa-phone-alt"></i>
                    <div>
                        <strong>Điện thoại</strong>
                        <span>1900-1234 (Hotline) / 0909.111.222 (Zalo)</span>
                    </div>
                </li>
                <li class="contact-info-item">
                    <i class="fas fa-envelope"></i>
                    <div>
                        <strong>Email</strong>
                        <span>info@flowershop.vn</span>
                    </div>
                </li>
                <li class="contact-info-item">
                    <i class="fas fa-clock"></i>
                    <div>
                        <strong>Giờ làm việc</strong>
                        <span>Thứ 2 - Chủ nhật (8:00 - 22:00)</span>
                    </div>
                </li>
            </ul>

            <h4 class="fw-bold mt-5 mb-3">Tìm chúng tôi trên bản đồ</h4>
            <div class="map-container">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.447033528096!2d106.70213131533276!3d10.777017262145396!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752f41b3156c7f%3A0x6b97a212356c0b39!2zTmjDoCBow6F0IFRow6BuaCBwaOG7kSBI4buTIENow60gTWluaA!5e0!3m2!1svi!2s!4v1668153400000!5m2!1svi!2s"
                        allowfullscreen="" loading="lazy"></iframe>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="contact-form-card">
                <h4 class="text-center mb-4">Gửi tin nhắn cho chúng tôi</h4>

                @using (Html.BeginForm("GuiLienHe", "Home", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="HoTen" class="form-label fw-semibold">Họ và tên *</label>
                        <input type="text" class_="form-control " style="border-radius:10px" id="HoTen" name="HoTen" required>
                    </div>

                    <div class="mb-3">
                        <label for="Email" class="form-label fw-semibold">Email *</label>
                        <input type="email" class="form-control" id="Email" name="Email" required>
                    </div>

                    <div class="mb-3">
                        <label for="ChuDe" class="form-label fw-semibold">Chủ đề</label>
                        <input type="text" class="form-control" id="ChuDe" name="ChuDe">
                    </div>

                    <div class="mb-3">
                        <label for="NoiDung" class="form-label fw-semibold">Nội dung tin nhắn *</label>
                        <textarea class="form-control" id="NoiDung" name="NoiDung" rows="5" required></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary-custom w-100 py-2 fs-6">
                        Gửi tin nhắn
                    </button>
                }
            </div>
        </div>
    </div>
</div>