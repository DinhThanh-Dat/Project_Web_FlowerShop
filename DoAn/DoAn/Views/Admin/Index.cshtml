@{
    ViewBag.Title = "Tổng quan";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    bool isAdmin = ViewBag.IsAdmin ?? false; // Lấy cờ từ Controller
}

<style>
    /* --- ADMIN DASHBOARD GLASS STYLE --- */

    /* 1. Card thống kê */
    .stat-glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.6);
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0 8px 30px rgba(0,0,0,0.05);
        transition: transform 0.3s;
        height: 100%;
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

        .stat-glass-card:hover {
            transform: translateY(-5px);
            background: rgba(255, 255, 255, 0.9);
        }

    /* Icon tròn */
    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-right: 20px;
        flex-shrink: 0;
    }

    /* Màu sắc riêng cho từng loại */
    .bg-gradient-pink {
        background: linear-gradient(135deg, #ec4899 0%, #ff8a80 100%);
        color: white;
    }

    .bg-gradient-blue {
        background: linear-gradient(135deg, #3b82f6 0%, #06b6d4 100%);
        color: white;
    }

    .bg-gradient-green {
        background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
        color: white;
    }

    .bg-gradient-orange {
        background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
        color: white;
    }

    /* Số liệu to */
    .stat-value {
        font-size: 1.8rem;
        font-weight: 800;
        color: #444;
    }

    .stat-label {
        color: #666;
        font-size: 0.95rem;
        font-weight: 500;
    }

    /* 2. Khung biểu đồ */
    .chart-glass-box {
        background: rgba(255, 255, 255, 0.6);
        backdrop-filter: blur(15px);
        border-radius: 25px;
        padding: 30px;
        border: 1px solid rgba(255,255,255,0.5);
        margin-top: 30px;
        box-shadow: 0 10px 40px rgba(236, 72, 153, 0.05);
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Dashboard</h2>
        <p class="text-secondary mb-0">
            Xin chào,
            <span class="text-pink fw-bold">@Session["TenNV"]</span>
            @(isAdmin ? "(Quản trị viên)" : "(Nhân viên)")
        </p>
    </div>
    <div class="date-badge px-3 py-2 rounded-pill bg-white shadow-sm text-muted small">
        <i class="far fa-calendar-alt me-2"></i> @DateTime.Now.ToString("dd/MM/yyyy")
    </div>
</div>

<div class="row g-4">

    <div class="col-md-4">
        <div class="stat-glass-card">
            <div class="stat-icon bg-gradient-orange">
                <i class="fas fa-bell"></i>
            </div>
            <div>
                <div class="stat-value text-warning">@ViewBag.SoDonHangMoi</div>
                <div class="stat-label">Đơn hàng mới chờ xử lý</div>
            </div>
            <a href="@Url.Action("DonHang", "Admin")" class="stretched-link"></a>
        </div>
    </div>

    @if (isAdmin)
    {
        <div class="col-md-4">
            <div class="stat-glass-card">
                <div class="stat-icon bg-gradient-green">
                    <i class="fas fa-wallet"></i>
                </div>
                <div>
                    <div class="stat-value text-success">@ViewBag.TongDoanhThu.ToString("N0") ₫</div>
                    <div class="stat-label">Tổng doanh thu (Thực nhận)</div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-glass-card">
                <div class="stat-icon bg-gradient-blue">
                    <i class="fas fa-users"></i>
                </div>
                <div>
                    <div class="stat-value text-primary">@ViewBag.SoKhachHang</div>
                    <div class="stat-label">Tổng số khách hàng</div>
                </div>
            </div>
        </div>
    }
    else
    {
        /* --- GIAO DIỆN RIÊNG CHO NHÂN VIÊN (Lấp khoảng trống) --- */
        <div class="col-md-8">
            <div class="stat-glass-card bg-white">
                <div class="p-2">
                    <h5 class="fw-bold text-pink"><i class="fas fa-heart me-2"></i>Chúc bạn một ngày làm việc vui vẻ!</h5>
                    <p class="text-muted mb-0">Hãy kiểm tra và xử lý các đơn hàng mới nhanh chóng để khách hàng hài lòng nhé.</p>
                </div>
            </div>
        </div>
    }
</div>

@if (isAdmin)
{
    <div class="chart-glass-box">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="fas fa-chart-line me-2 text-pink"></i>Biểu đồ doanh thu năm @ViewBag.CurrentYear
            </h5>
            <span class="badge bg-pink-light text-pink border border-pink">Đơn vị: VNĐ</span>
        </div>

        <div style="position: relative; height: 350px; width: 100%;">
            <canvas id="revenueChart"></canvas>
        </div>
    </div>
}

@section Scripts {
    @if (isAdmin)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var chartData = "@ViewBag.ChartData".split(',').map(Number);
                var labels = ['T1', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'T8', 'T9', 'T10', 'T11', 'T12'];

                var ctx = document.getElementById('revenueChart').getContext('2d');

                // Tạo Gradient màu hồng cho đẹp
                var gradient = ctx.createLinearGradient(0, 0, 0, 400);
                gradient.addColorStop(0, 'rgba(236, 72, 153, 0.5)'); // Hồng đậm ở trên
                gradient.addColorStop(1, 'rgba(236, 72, 153, 0.0)'); // Trong suốt ở dưới

                var revenueChart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Doanh thu',
                            data: chartData,
                            fill: true, // Tô màu bên dưới đường
                            backgroundColor: gradient,
                            borderColor: '#ec4899',
                            borderWidth: 3,
                            pointBackgroundColor: '#fff',
                            pointBorderColor: '#ec4899',
                            pointRadius: 5,
                            pointHoverRadius: 7,
                            tension: 0.4 // Đường cong mềm mại (Spline)
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }, // Ẩn chú thích thừa
                            tooltip: {
                                backgroundColor: 'rgba(255, 255, 255, 0.9)',
                                titleColor: '#333',
                                bodyColor: '#ec4899',
                                bodyFont: { weight: 'bold' },
                                borderColor: '#ec4899',
                                borderWidth: 1,
                                padding: 10,
                                displayColors: false,
                                callbacks: {
                                    label: function(context) {
                                        return context.parsed.y.toLocaleString('vi-VN') + ' ₫';
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: { color: 'rgba(0,0,0,0.05)' },
                                ticks: {
                                    callback: function (value) {
                                        if (value >= 1000000) return (value / 1000000) + ' Tr';
                                        return value.toLocaleString('vi-VN');
                                    },
                                    color: '#888'
                                }
                            },
                            x: {
                                grid: { display: false },
                                ticks: { color: '#888' }
                            }
                        }
                    }
                });
            });
        </script>
    }
}